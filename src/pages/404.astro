---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Not found" description="That page is not on flickos.net.">
	<section class="page">
		<h1 class="flick-display">Page not found</h1>
		<p>That URL is not part of this site.</p>
		<p class="links">
			<a class="flick-btn primary" href="/">Home</a>
			<a class="flick-btn ghost" href="/docs/01-overview/">Docs</a>
			<a class="flick-btn ghost" href="/download/">Download</a>
		</p>
	</section>
</MarketingLayout>

<style>
	.page {
		max-width: 36rem;
		margin: 0 auto;
		padding: 4rem 1.25rem;
		text-align: center;
	}
	h1 {
		margin: 0;
		font-size: 2.25rem;
		color: var(--flick-title);
	}
	p {
		margin: 0.75rem 0 0;
		color: var(--flick-muted);
	}
	.links {
		margin-top: 1.75rem !important;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}
</style>
