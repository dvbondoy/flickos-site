---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import redmond from '../assets/screenshots/layout-redmond.png';
import cupertino from '../assets/screenshots/layout-cupertino.png';
import traditional from '../assets/screenshots/layout-traditional.png';
import history from '../assets/screenshots/history.png';
import { highlights } from '../data/features';

const specs = [
	{ label: 'Debian 13', detail: 'trixie · Linux 6.12 LTS' },
	{ label: 'labwc Wayland', detail: 'lightweight compositor' },
	{ label: 'amd64', detail: 'BIOS + UEFI hybrid ISO' },
	{ label: '~1.4 GB', detail: 'live ISO + Calamares' },
];

const layouts = [
	{
		name: 'Redmond',
		blurb: 'One bottom panel — the default.',
		image: redmond,
	},
	{
		name: 'Cupertino',
		blurb: 'Top bar and an auto-hiding dock.',
		image: cupertino,
	},
	{
		name: 'Traditional',
		blurb: 'Top panel with a window list.',
		image: traditional,
	},
];

const keys = [
	{ key: 'Hold Super', action: 'Shortcut sheet' },
	{ key: 'Tap Super', action: 'Start menu' },
	{ key: 'Super+Enter', action: 'Terminal' },
	{ key: 'Super+D', action: 'App launcher' },
	{ key: 'Super+E', action: 'File manager' },
	{ key: 'Super+B', action: 'Web browser' },
	{ key: 'Super+V', action: 'Clipboard history' },
	{ key: 'Super+Q', action: 'Close window' },
	{ key: 'Super+L', action: 'Lock screen' },
	{ key: 'Super+Shift+E', action: 'Log out' },
	{ key: 'Super+T', action: 'Tiling on/off' },
];
---

<MarketingLayout
	title="FlickOS"
	description="FlickOS 2.0 is a lightweight Debian 13 Wayland desktop. Live ISO, Calamares installer, Arc look, three layouts."
>
	<section class="hero" aria-label="FlickOS">
		<div class="hero-copy flick-anim-rise">
			<p class="brand flick-display">FlickOS</p>
			<a class="pill" href="#undo"><span class="pill-tag">New</span> An Undo button for every change</a>
			<h1 class="flick-display">A light Debian desktop that feels finished.</h1>
			<p class="lede">
				Version 2.0 on Debian 13 with a labwc Wayland session, Arc theming, and a live ISO you can install when you are ready.
			</p>
			<div class="cta">
				<a class="flick-btn primary" href="/download/">Download 2.0</a>
				<a class="flick-btn ghost" href="/docs/01-overview/">Read the docs</a>
			</div>
		</div>
		<div class="hero-visual flick-anim-hero" style="animation-delay: 0.12s">
			<Image
				src={redmond}
				alt="FlickOS Redmond layout desktop in a live session"
				widths={[720, 1080, 1366]}
				sizes="100vw"
				class="hero-shot"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</section>

	<section class="specs flick-anim-fade" style="animation-delay: 0.25s" aria-label="Specifications">
		<ul>
			{
				specs.map((s) => (
					<li>
						<span class="label">{s.label}</span>
						<span class="detail">{s.detail}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section features">
		<div class="section-head">
			<h2 class="flick-display">Built for everyday use</h2>
			<p>What ships in FlickOS 2.0 — the same stack the ISO boots.</p>
		</div>
		<ul class="feature-list">
			{
				highlights.map((f) => (
					<li>
						<h3>{f.title}</h3>
						<p>{f.body}</p>
						{f.href ? (
							<p class="feature-link">
								<a href={f.href}>{f.linkLabel}</a>
							</p>
						) : null}
					</li>
				))
			}
		</ul>
		<p class="more">
			<a href="/features/">See all features</a>
		</p>
	</section>

	<section class="section undo" id="undo">
		<div class="undo-grid">
			<div class="undo-copy">
				<p class="eyebrow">Settings → History</p>
				<h2 class="flick-display">Every change has an Undo button</h2>
				<p class="undo-lede">
					Tried a new layout? Turned on tiling by accident? Removed an app you needed? History lists what changed, in plain words and newest first, with Undo next to each change.
				</p>
				<ul class="undo-points">
					<li><strong>Settings.</strong> Layout, style, tiling, input, power, default and startup apps, firewall, updates — whether you changed them in Settings, with a key, or in a terminal.</li>
					<li><strong>Software.</strong> Installs and removals from Software or apt. Undo shows what it will do before it asks for your password.</li>
					<li><strong>Put Back as It Was…</strong> Returns your settings to how they were on an earlier day, and that can be undone too.</li>
				</ul>
				<div class="undo-note">
					<h3>How is this different from snapshots?</h3>
					<p>
						Timeshift and Snapper roll the whole system back to a point in time. History undoes one change and leaves the rest alone — no snapshots, no reboot, no terminal, and nothing running in the background. As far as we know, no other Linux desktop has an undo list for its own settings.
					</p>
				</div>
			</div>
			<figure class="undo-shot">
				<Image
					src={history}
					alt="FlickOS Settings window on the History page: installed and removed packages listed by day, each with an Undo button"
					widths={[640, 960, 1366]}
					sizes="(max-width: 64rem) 100vw, 55vw"
				/>
			</figure>
		</div>
	</section>

	<section class="section layouts">
		<div class="section-head">
			<h2 class="flick-display">Three layouts, one desktop</h2>
			<p>Switch live from All Settings → Desktop Layout &amp; Style.</p>
		</div>
		<ul class="layout-grid">
			{
				layouts.map((l) => (
					<li>
						<div class="shot">
							<Image src={l.image} alt={`${l.name} layout`} widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 33vw" />
						</div>
						<h3>{l.name}</h3>
						<p>{l.blurb}</p>
					</li>
				))
			}
		</ul>
		<p class="more">
			<a href="/screenshots/">See more screenshots</a>
		</p>
	</section>

	<section class="section keys">
		<div class="section-head">
			<h2 class="flick-display">Keybindings</h2>
			<p>Right-click the desktop for the full menu.</p>
		</div>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th scope="col">Key</th>
						<th scope="col">Action</th>
					</tr>
				</thead>
				<tbody>
					{
						keys.map((k) => (
							<tr>
								<td><kbd>{k.key}</kbd></td>
								<td>{k.action}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>
</MarketingLayout>

<style>
	.hero {
		display: grid;
		gap: 0;
	}
	.hero-copy {
		max-width: 40rem;
		margin: 0 auto;
		padding: 2rem 1.25rem 1.5rem;
		text-align: center;
	}
	@media (min-width: 48rem) {
		.hero-copy {
			padding: 2.75rem 1.25rem 1.75rem;
		}
	}
	.brand {
		margin: 0 0 0.75rem;
		font-size: clamp(2.75rem, 8vw, 4.25rem);
		font-weight: 700;
		color: var(--flick-title);
		line-height: 1;
	}
	.hero-copy h1 {
		margin: 0;
		font-size: clamp(1.35rem, 3.2vw, 1.85rem);
		font-weight: 600;
		color: var(--flick-fg);
		line-height: 1.25;
	}
	.lede {
		margin: 1rem auto 0;
		max-width: 34rem;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--flick-muted);
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1rem;
		padding: 0.3rem 0.85rem 0.3rem 0.35rem;
		border: 1px solid var(--flick-border);
		border-radius: 999px;
		background: var(--flick-panel);
		color: var(--flick-fg) !important;
		font-size: 0.9rem;
		text-decoration: none !important;
	}
	.pill:hover,
	.pill:focus-visible {
		border-color: var(--flick-accent);
	}
	.pill-tag {
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--flick-accent);
		color: var(--flick-accent-fg);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	.cta {
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.75rem;
	}
	@media (min-width: 30rem) {
		.cta {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: center;
			align-items: center;
		}
	}
	.hero-visual {
		width: 100%;
		line-height: 0;
		border-block: 1px solid var(--flick-border);
		background: var(--flick-panel);
	}
	.hero-shot {
		width: 100%;
		height: auto;
		display: block;
	}
	.specs {
		max-width: 72rem;
		margin: 0 auto;
		padding: 1.75rem 1.25rem;
	}
	.specs ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem 1.5rem;
	}
	@media (min-width: 48rem) {
		.specs ul {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.specs .label {
		display: block;
		font-weight: 600;
		color: var(--flick-title);
	}
	.specs .detail {
		display: block;
		font-size: 0.9rem;
		color: var(--flick-muted);
		margin-top: 0.15rem;
	}
	.section {
		max-width: 72rem;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 0;
	}
	.section.keys {
		padding-bottom: 0.5rem;
	}
	@media (min-width: 48rem) {
		.section {
			padding-top: 3rem;
		}
	}
	.section-head {
		max-width: 36rem;
		margin-bottom: 1.75rem;
	}
	.section-head h2 {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2rem);
		color: var(--flick-title);
	}
	.section-head p {
		margin: 0.5rem 0 0;
		color: var(--flick-muted);
	}
	.feature-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem 2rem;
	}
	@media (min-width: 48rem) {
		.feature-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 64rem) {
		.feature-list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.feature-list h3 {
		margin: 0 0 0.4rem;
		font-size: 1.05rem;
		color: var(--flick-title);
	}
	.feature-list p {
		margin: 0;
		line-height: 1.5;
		color: var(--flick-fg);
		opacity: 0.9;
	}
	.feature-link {
		margin-top: 0.5rem !important;
		opacity: 1 !important;
		font-size: 0.95rem;
	}
	.undo {
		scroll-margin-top: 4.5rem;
	}
	.undo-grid {
		display: grid;
		gap: 2rem;
		align-items: center;
	}
	@media (min-width: 64rem) {
		.undo-grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
			gap: 2.5rem;
		}
	}
	.eyebrow {
		margin: 0 0 0.4rem;
		color: var(--flick-accent);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}
	.undo-copy h2 {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2rem);
		color: var(--flick-title);
		line-height: 1.2;
	}
	.undo-lede {
		margin: 0.75rem 0 0;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--flick-fg);
	}
	.undo-points {
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.75rem;
	}
	.undo-points li {
		padding-left: 0.9rem;
		border-left: 2px solid var(--flick-accent);
		line-height: 1.5;
		color: var(--flick-fg);
		opacity: 0.9;
	}
	.undo-points strong {
		color: var(--flick-title);
	}
	.undo-note {
		margin-top: 1.5rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--flick-border);
		border-radius: 0.4rem;
		background: var(--flick-panel);
	}
	.undo-note h3 {
		margin: 0 0 0.35rem;
		font-size: 1rem;
		color: var(--flick-title);
	}
	.undo-note p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--flick-muted);
	}
	.undo-shot {
		margin: 0;
		line-height: 0;
		border: 1px solid var(--flick-border);
		background: var(--flick-panel);
	}
	.undo-shot :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}
	.layout-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
	}
	@media (min-width: 56rem) {
		.layout-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.layout-grid .shot {
		aspect-ratio: 1366 / 768;
		overflow: hidden;
		border: 1px solid var(--flick-border);
		background: var(--flick-surface, #1b1f27);
	}
	.layout-grid .shot :global(img) {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: top center;
	}
	.layout-grid h3 {
		margin: 0.75rem 0 0.25rem;
		color: var(--flick-title);
	}
	.layout-grid p {
		margin: 0;
		color: var(--flick-muted);
		font-size: 0.95rem;
	}
	.more {
		margin: 1.25rem 0 0;
	}
	.keys .table-wrap {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		margin-inline: -0.25rem;
		padding-inline: 0.25rem;
	}
	.keys table {
		width: 100%;
		min-width: 18rem;
		border-collapse: collapse;
		font-size: 0.95rem;
	}
	.keys th,
	.keys td {
		text-align: left;
		padding: 0.7rem 0.4rem;
		border-bottom: 1px solid var(--flick-border);
		vertical-align: top;
	}
	.keys th {
		color: var(--flick-muted);
		font-weight: 500;
		font-size: 0.85rem;
	}
	.keys td:first-child {
		white-space: nowrap;
		padding-right: 0.75rem;
	}
	kbd {
		font-family: ui-monospace, 'IBM Plex Mono', monospace;
		font-size: 0.85em;
		color: var(--flick-title);
		background: var(--flick-base);
		border: 1px solid var(--flick-border);
		padding: 0.15rem 0.4rem;
		border-radius: 0.25rem;
		white-space: nowrap;
	}
</style>
