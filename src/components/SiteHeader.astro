---
import logo from '../assets/brand/flickos.svg';
import { donate } from '../config/donate';

const path = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/features/', label: 'Features' },
	{ href: '/screenshots/', label: 'Screenshots' },
	{ href: '/download/', label: 'Download' },
	{ href: '/docs/01-overview/', label: 'Docs' },
];
---

<header class="site-header">
	<div class="inner">
		<a class="brand" href="/" aria-label="FlickOS home">
			<img src={logo.src} alt="" width="36" height="36" />
			<span class="flick-display">FlickOS</span>
		</a>
		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav"
			data-menu-toggle
		>
			<span class="sr-only">Menu</span>
			<span class="menu-icon" aria-hidden="true"></span>
		</button>
		<nav id="site-nav" aria-label="Primary" data-nav>
			{
				links.map((link) => (
					<a
						href={link.href}
						aria-current={
							link.href === '/'
								? path === '/'
									? 'page'
									: undefined
								: path.startsWith(link.href)
									? 'page'
									: undefined
						}
					>
						{link.label}
					</a>
				))
			}
			{
				donate.enabled && (
					<a
						class="donate"
						href={donate.href}
						aria-current={path.startsWith(donate.href) ? 'page' : undefined}
					>
						<span aria-hidden="true">♥</span> Donate
					</a>
				)
			}
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector('.site-header');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const nav = document.querySelector<HTMLElement>('[data-nav]');

	function setOpen(open: boolean) {
		header?.classList.toggle('is-open', open);
		toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
	}

	toggle?.addEventListener('click', () => {
		setOpen(!header?.classList.contains('is-open'));
	});

	nav?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setOpen(false));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setOpen(false);
	});

	window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
		if (event.matches) setOpen(false);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		backdrop-filter: blur(10px);
		background: color-mix(in srgb, var(--flick-panel) 88%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--flick-border) 80%, transparent);
	}
	.site-header.is-open {
		background: var(--flick-panel);
	}
	.inner {
		max-width: 72rem;
		margin-inline: auto;
		padding: 0.75rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: var(--flick-title);
		font-weight: 600;
		font-size: 1.2rem;
		min-width: 0;
		position: relative;
		z-index: 1;
	}
	.brand img {
		border-radius: 8px;
		flex-shrink: 0;
	}
	.menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin: -0.35rem;
		border: 1px solid color-mix(in srgb, var(--flick-fg) 22%, transparent);
		border-radius: 0.35rem;
		background: transparent;
		color: var(--flick-fg);
		cursor: pointer;
		position: relative;
		z-index: 1;
		flex-shrink: 0;
	}
	.menu-toggle:hover,
	.menu-toggle:focus-visible {
		border-color: var(--flick-accent);
		color: var(--flick-accent);
		outline: none;
	}
	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		display: block;
		width: 1.15rem;
		height: 2px;
		background: currentColor;
		border-radius: 1px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.menu-icon {
		position: relative;
	}
	.menu-icon::before,
	.menu-icon::after {
		content: '';
		position: absolute;
		left: 0;
	}
	.menu-icon::before {
		top: -6px;
	}
	.menu-icon::after {
		top: 6px;
	}
	.site-header.is-open .menu-icon {
		background: transparent;
	}
	.site-header.is-open .menu-icon::before {
		top: 0;
		transform: rotate(45deg);
	}
	.site-header.is-open .menu-icon::after {
		top: 0;
		transform: rotate(-45deg);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	nav {
		display: none;
		flex-direction: column;
		gap: 0.15rem;
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		padding: 0.35rem 1.25rem 1rem;
		background: color-mix(in srgb, var(--flick-panel) 97%, transparent);
		border-bottom: 1px solid var(--flick-border);
		box-shadow: 0 12px 24px color-mix(in srgb, var(--flick-border) 55%, transparent);
		backdrop-filter: blur(12px);
	}
	.site-header.is-open nav {
		display: flex;
	}
	nav a {
		display: block;
		padding: 0.85rem 0.35rem;
		color: var(--flick-fg) !important;
		text-decoration: none !important;
		opacity: 0.9;
		font-size: 1.05rem;
		border-radius: 0.3rem;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--flick-accent) !important;
		opacity: 1;
	}
	nav a.donate {
		color: var(--flick-accent) !important;
		font-weight: 600;
		opacity: 1;
	}
	@media (min-width: 48rem) {
		.menu-toggle {
			display: none;
		}
		nav {
			display: flex;
			flex-direction: row;
			align-items: center;
			position: static;
			inset: auto;
			padding: 0;
			gap: 0.35rem 1.15rem;
			background: transparent;
			border: 0;
			backdrop-filter: none;
			font-size: 0.95rem;
		}
		nav a {
			display: inline;
			padding: 0.25rem 0;
		}
		nav a.donate {
			margin-left: 0.25rem;
			padding: 0.3rem 0.8rem;
			border-radius: 999px;
			background: var(--flick-accent);
			color: var(--flick-accent-fg) !important;
			font-weight: 600;
			opacity: 1;
		}
		nav a.donate:hover,
		nav a.donate[aria-current='page'] {
			filter: brightness(1.08);
			color: var(--flick-accent-fg) !important;
		}
	}
</style>
